# PostgreSQL
DATABASE_URL=postgresql://erp:erp@localhost:5432/erp

# Server (Railway/Fly inject PORT automatically)
PORT=3001

# Better Auth — MUST be your public HTTPS URL in production
BETTER_AUTH_SECRET=dev-only-secret-change-me-in-production
BETTER_AUTH_URL=http://localhost:3001

# Comma-separated extra trusted origins (optional)
# BETTER_AUTH_TRUSTED_ORIGINS=https://your-app.example,http://localhost:3001

# Set to 1 only if you run migrations separately (e.g. CI job)
# SKIP_MIGRATIONS=0
